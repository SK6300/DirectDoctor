<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="400"
    android:exitFadeDuration="400">

    <item android:state_focused="true">
        <layer-list>
            <item android:bottom="0dp" android:left="0dp" android:right="0dp" android:top="0dp">
                <shape android:shape="rectangle">
                    <corners android:radius="12dp" />
                    <stroke android:width="6dp" android:color="#1A00621E" /> </shape>
            </item>

            <item android:bottom="1.5dp" android:left="1.5dp" android:right="1.5dp" android:top="1.5dp">
                <shape android:shape="rectangle">
                    <corners android:radius="12dp" />
                    <stroke android:width="4dp" android:color="#3300621E" /> </shape>
            </item>

            <item android:bottom="3dp" android:left="3dp" android:right="3dp" android:top="3dp">
                <shape android:shape="rectangle">
                    <corners android:radius="12dp" />
                    <stroke android:width="2dp" android:color="#6600621E" /> </shape>
            </item>

            <item android:bottom="4dp" android:left="4dp" android:right="4dp" android:top="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="#FFFFFF" />
                    <corners android:radius="12dp" />
                    <stroke android:width="1.5dp" android:color="#00621E" /> </shape>
            </item>
        </layer-list>
    </item>

    <item>
        <layer-list>
            <item android:bottom="0dp" android:left="0dp" android:right="0dp" android:top="0dp">
                <shape android:shape="rectangle">
                    <solid android:color="#00000000" />
                    <corners android:radius="12dp" />
                    <stroke android:width="6dp" android:color="#00000000" />
                </shape>
            </item>

            <item android:bottom="4dp" android:left="4dp" android:right="4dp" android:top="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="#FFFFFF" />
                    <corners android:radius="12dp" />
                    <stroke android:width="1dp" android:color="#CCCCCC" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>