<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <ImageView
        android:id="@+id/mainLogo"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:src="@drawable/dd_stamp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Info Guide"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="20dp"
        android:layout_marginTop="45dp" />

    <Button
        android:id="@+id/btnAsUser"
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:background="@drawable/login"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="50dp" />

    <!-- 🚀 Master Notification Dot for Profile Icon -->
    <TextView
        android:id="@+id/tvProfileUnreadBadge"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:background="@drawable/badge_bg"
        android:elevation="10dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@+id/btnAsUser"
        app:layout_constraintEnd_toEndOf="@+id/btnAsUser" />

    <LinearLayout
        android:id="@+id/topSearchBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="15dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@+id/mainLogo">

        <EditText
            android:id="@+id/etSearchBox"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:hint="Search doctors, hospitals..."
            android:background="@android:drawable/editbox_background"
            android:elevation="8dp"
            android:outlineSpotShadowColor="#00621E"
            android:paddingStart="15dp"
            android:paddingEnd="15dp" />

        <ImageView
            android:id="@+id/btnSort"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="10dp"
            android:src="@android:drawable/ic_menu_sort_by_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/mainNestedScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/topSearchBar"
        app:layout_constraintBottom_toTopOf="@+id/bottomNavBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDoctorsHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:text="Our Doctors"
                android:textColor="#003366"
                android:textSize="20sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSuggestedDoctors"
                android:layout_width="match_parent"
                android:layout_height="329dp"
                android:clipToPadding="false"
                android:paddingTop="20dp"
                android:paddingBottom="20dp" />

            <View
                android:id="@+id/navDividerLine"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:background="@drawable/app_gradient"
                android:layout_marginHorizontal="30dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/tvHospitalsHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hospitals"
                android:textStyle="bold"
                android:textSize="20sp"
                android:textColor="#003366"
                android:layout_marginStart="20dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvBlankList"
                android:layout_width="match_parent"
                android:layout_height="400dp"
                android:clipToPadding="false"
                android:paddingTop="20dp"
                android:paddingBottom="20dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <WebView
        android:id="@+id/infoWebView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:visibility="gone"
        android:elevation="8dp"
        app:layout_constraintTop_toBottomOf="@+id/mainLogo"
        app:layout_constraintBottom_toTopOf="@+id/bottomNavBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/navDivider"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="#D0D0D0"
        app:layout_constraintBottom_toTopOf="@+id/bottomNavBar" />

    <LinearLayout
        android:id="@+id/bottomNavBar"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:background="@drawable/app_gradient"
        android:gravity="center"
        android:orientation="horizontal"
        android:weightSum="5"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:id="@+id/navDoctor"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="5dp"
            android:src="@drawable/doct"
            app:tint="#FFFFFF" />

        <ImageView
            android:id="@+id/navHospital"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="18dp"
            android:src="@drawable/hospital"
            app:tint="#FFFFFF" />

        <ImageView
            android:id="@+id/navHome"
            android:layout_width="3dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="3dp"
            android:src="@drawable/home"
            app:tint="#FFFFFF" />

        <ImageView
            android:id="@+id/navPromotion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="13dp"
            android:src="@drawable/prom"
            app:tint="#FFFFFF" />

        <ImageView
            android:id="@+id/navContact"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="5dp"
            android:src="@android:drawable/ic_menu_call"
            app:tint="#FFFFFF" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>