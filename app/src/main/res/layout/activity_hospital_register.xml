<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="25dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Register Hospital"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#0A32B3"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="25dp"/>

        <EditText
            android:id="@+id/etHospName"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Hospital Name"
            android:background="@android:drawable/editbox_background"
            android:padding="10dp"
            android:textColor="#00621E"
            android:layout_marginBottom="15dp"/>

        <EditText
            android:id="@+id/etHospAddress"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:hint="Full Address"
            android:gravity="top|start"
            android:background="@android:drawable/editbox_background"
            android:padding="10dp"
            android:textColor="#00621E"
            android:layout_marginBottom="15dp"/>

        <EditText
            android:id="@+id/etHospLocation"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Google Maps Location Link"
            android:background="@android:drawable/editbox_background"
            android:padding="10dp"
            android:textColor="#00621E"
            android:layout_marginBottom="15dp"/>

        <EditText
            android:id="@+id/etHospContact"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Emergency Contact Number"
            android:inputType="phone"
            android:background="@android:drawable/editbox_background"
            android:padding="10dp"
            android:textColor="#00621E"
            android:layout_marginBottom="15dp"/>

        <EditText
            android:id="@+id/etHospWebsite"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Website Link"
            android:inputType="textUri"
            android:background="@android:drawable/editbox_background"
            android:padding="10dp"
            android:textColor="#00621E"
            android:layout_marginBottom="15dp"/>

        <EditText
            android:id="@+id/etHospTimings"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Hospital Timings (e.g. 24/7 or 9 AM - 9 PM)"
            android:background="@android:drawable/editbox_background"
            android:padding="10dp"
            android:textColor="#00621E"
            android:layout_marginBottom="15dp"/>

        <EditText
            android:id="@+id/etHospFacilities"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:hint="Facilities (e.g. ICU, Ambulance, Pharmacy)"
            android:gravity="top|start"
            android:inputType="textMultiLine"
            android:background="@android:drawable/editbox_background"
            android:padding="10dp"
            android:textColor="#00621E"
            android:layout_marginBottom="15dp"/>

        <EditText
            android:id="@+id/etHospDoctorsList"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:hint="Available Doctors / Departments"
            android:gravity="top|start"
            android:inputType="textMultiLine"
            android:background="@android:drawable/editbox_background"
            android:padding="10dp"
            android:textColor="#00621E"
            android:layout_marginBottom="15dp"/>

        <EditText
            android:id="@+id/etHospReviews"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Google Reviews Link"
            android:inputType="textUri"
            android:background="@android:drawable/editbox_background"
            android:textColor="#00621E"
            android:padding="10dp"
            android:layout_marginBottom="25dp"/>

        <Button
            android:id="@+id/btnSubmitHosp"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Submit Application"
            android:background="@drawable/app_gradient"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginBottom="30dp"/>

    </LinearLayout>
</ScrollView>