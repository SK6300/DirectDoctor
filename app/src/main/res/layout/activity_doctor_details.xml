<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="-140dp"
                android:layout_marginTop="20dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:src="?attr/homeAsUpIndicator" />


        <ImageView
            android:id="@+id/ivDetailPic"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_marginTop="0dp"
            android:scaleType="centerCrop"
            android:src="@drawable/doctor_profile" />

        <TextView
            android:id="@+id/tvDetailName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#003366"
            android:layout_marginTop="15dp" />

        <TextView
            android:id="@+id/tvDetailSpec"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textColor="#02AAB0"
            android:layout_marginTop="5dp" />

        <TextView
            android:id="@+id/tvConnectionHighlight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:background="#E8F5E9"
            android:padding="12dp"
            android:text="Connected via: Status"
            android:textColor="#2E7D32"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"
            android:visibility="gone"
            app:cornerRadius="8dp"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            app:cardCornerRadius="15dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Professional &amp; Contact Info"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="#003366"
                    android:paddingBottom="15dp"/>

                <TextView
                    android:id="@+id/tvDetailFee"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textColor="#02AAB0"
                    android:textStyle="bold"
                    android:paddingBottom="10dp"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/tvDetailMobile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textColor="#1C53FF"
                    android:textStyle="bold"
                    android:paddingBottom="10dp"/>

                <TextView
                    android:id="@+id/tvDetailClinic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textColor="#333333"
                    android:paddingBottom="10dp"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/tvDetailAge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textColor="#333333"
                    android:paddingBottom="10dp"/>

                <TextView
                    android:id="@+id/tvDetailGender"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textColor="#333333"
                    android:paddingBottom="10dp"/>

                <TextView
                    android:id="@+id/tvDetailAvailability"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:textSize="16sp"
                    android:textColor="#2E7D32"
                    android:textStyle="bold"
                    android:paddingBottom="10dp"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/tvDetailBooked"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:textSize="16sp"
                    android:textColor="#D32F2F"
                    android:textStyle="bold"
                    android:paddingBottom="10dp"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/tvDetailAbout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textSize="16sp"
                    android:textColor="#333333"
                    android:visibility="gone"/>

                <LinearLayout
                    android:id="@+id/llDynamicDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="10dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="20dp"
            android:weightSum="2">

            <Button
                android:id="@+id/btnViewPortfolio"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_weight="1"
                android:text="Portfolio"
                android:background="@drawable/app_gradient_2"
                android:layout_marginEnd="5dp"
                app:cornerRadius="10dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnViewWebsite"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_weight="1"
                android:text="Website"
                android:background="@drawable/app_gradient_1"
                android:layout_marginStart="5dp"
                app:cornerRadius="10dp"
                android:visibility="gone" />

        </LinearLayout>

        <Button
            android:id="@+id/btnBookAppointment"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Book Your Appointment Today"
            android:textColor="#FFFFFF"
            android:background="@drawable/app_gradient"
            android:textStyle="bold"
            android:textSize="16sp"
            app:cornerRadius="12dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="30dp" />

    </LinearLayout>
</ScrollView>