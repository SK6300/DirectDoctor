<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:padding="24dp"
    android:layout_margin="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Direct Doctor"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#0D47A1"
        android:gravity="center"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Concept: Patients ki near location lo best treatments and verified doctors ni easy ga vethukkovadaniki oka platform."
        android:textSize="16sp"
        android:textColor="#333333"
        android:layout_marginBottom="12dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Reason: Improve healthcare flexibility and help boost doctors' visibility via subscription model."
        android:textSize="16sp"
        android:textColor="#333333"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/btnClose"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Got it!"
        android:backgroundTint="#0288D1"
        android:textColor="#FFFFFF"/>
</LinearLayout>